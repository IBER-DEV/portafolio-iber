---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Iber Masco, ingeniero de sistemas y desarrollador full stack en Barranquilla, Colombia. Plataformas SaaS, PWA, apps móviles, servidores MCP y desarrollo con agentes de IA." } = Astro.props;
const baseUrl = Astro.site ?? Astro.url;
const basePath = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, baseUrl).toString();
const ogImage = new URL(`${basePath}images/og.jpg`, baseUrl).toString();
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Iber Masco',
  jobTitle: 'Ingeniero de Sistemas y Desarrollador Full Stack',
  description,
  url: canonicalURL,
  image: ogImage,
  email: 'mailto:ivermasco5@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Barranquilla',
    addressCountry: 'CO'
  },
  knowsAbout: ['React', 'TypeScript', 'Django', 'Python', 'PostgreSQL', 'PWA', 'Capacitor', 'Model Context Protocol', 'Agentes de IA'],
  sameAs: ['https://www.linkedin.com/in/ibermasco', 'https://github.com/IBER-DEV']
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow, max-image-preview:large">
    <meta name="author" content="Iber Masco">
    <meta name="theme-color" content="#0C0C0C">
    <link rel="canonical" href={canonicalURL}>
    <link rel="alternate" hreflang="es" href={canonicalURL}>

    <!-- Open Graph -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:site_name" content="Iber Masco Portfolio">
    <meta property="og:locale" content="es_CO">
    <meta property="og:image" content={ogImage}>

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <title>{title}</title>

    <noscript>
      <style>
        [data-fade] { opacity: 1 !important; transform: none !important; }
        [data-char] { opacity: 1 !important; }
      </style>
    </noscript>
  </head>
  <body>
    <main class="bg-[#0C0C0C]" style="overflow-x: clip;">
      <slot />
    </main>
  </body>
</html>
