---
const base = import.meta.env.BASE_URL;

// Mockups y capturas reales de proyectos: muestran la variedad de productos construidos.
const images = [
  'hallazgos-laptop',
  'nexo-desktop2',
  'cashflow-phone',
  'salda-desktop',
  'futurepro-laptop',
  'turnio-desktop2',
  'hallazgos-detail',
  'modapos-desktop',
  'cashflow-laptop',
  'bocado-desktop2',
  'futurepro-phone',
  'nexo-desktop',
  'hallazgos-phone',
  'salda-desktop2',
  'cashflow-detail',
  'turnio-desktop',
  'futurepro-detail',
  'hallazgos-desktop',
  'cashflow-desktop',
  'futurepro-desktop',
].map((name) => `${base}images/marquee/${name}.webp`);

const row1 = images.slice(0, 10);
const row2 = images.slice(10);
const rows = [
  { items: [...row1, ...row1, ...row1], direction: 1 },
  { items: [...row2, ...row2, ...row2], direction: -1 },
];
---

<section class="bg-[#0C0C0C] pb-10 pt-24 sm:pt-32 md:pt-40" data-marquee aria-hidden="true">
  <div class="flex flex-col gap-3">
    {
      rows.map((row) => (
        <div
          class="flex justify-center gap-3"
          data-marquee-row={row.direction}
          style={`will-change: transform; transform: translateX(${row.direction * -200}px);`}
        >
          {row.items.map((src) => (
            <img
              src={src}
              alt=""
              loading="lazy"
              decoding="async"
              width="420"
              height="270"
              class="h-[270px] w-[420px] shrink-0 rounded-2xl object-cover"
            />
          ))}
        </div>
      ))
    }
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-marquee]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-marquee-row]'));

  if (section && rows.length) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const sectionTop = section.getBoundingClientRect().top + window.scrollY;
      const offset = (window.scrollY - sectionTop + window.innerHeight) * 0.3;

      for (const row of rows) {
        const direction = Number(row.dataset.marqueeRow);
        row.style.transform = `translateX(${direction * (offset - 200)}px)`;
      }
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
