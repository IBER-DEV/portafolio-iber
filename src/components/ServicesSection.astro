---
import FadeIn from './FadeIn.astro';

const services = [
  {
    name: 'Agentes de IA & MCP',
    description:
      'Construyo servidores MCP, asesores con tool-calling y flujos de trabajo con agentes como Claude Code, tanto dentro del producto como en el proceso de desarrollo.',
  },
  {
    name: 'Plataformas SaaS Full Stack',
    description:
      'Productos multi-tenant de punta a punta: React y TanStack en el frontend, Django REST y PostgreSQL en el backend, con roles, auditoría y pruebas automatizadas.',
  },
  {
    name: 'Apps Móviles & PWA',
    description:
      'Apps instalables y offline-first con PWA y Capacitor, reutilizando el mismo código web para llegar a Android sin duplicar esfuerzo.',
  },
  {
    name: 'Sistemas en Tiempo Real',
    description:
      'Automatización de operaciones físicas, como patios logísticos, agendas y turnos, con visibilidad en vivo y trazabilidad por etapas.',
  },
  {
    name: 'Despliegue & DevOps',
    description:
      'Docker, Cloudflare Workers, Railway y CI con GitHub Actions para llevar cada proyecto a producción y mantenerlo estable.',
  },
];
---

<section
  id="services"
  class="rounded-t-[40px] bg-white px-5 py-20 sm:rounded-t-[50px] sm:px-8 sm:py-24 md:rounded-t-[60px] md:px-10 md:py-32"
>
  <h2
    class="mb-16 text-center font-black uppercase leading-none tracking-tight text-[#0C0C0C] sm:mb-20 md:mb-28"
    style="font-size: clamp(3rem, 12vw, 160px);"
  >
    Lo que hago
  </h2>

  <ul class="mx-auto max-w-5xl">
    {
      services.map((service, i) => (
        <FadeIn
          as="li"
          delay={i * 0.1}
          class="flex items-start gap-6 py-8 sm:gap-10 sm:py-10 md:gap-14 md:py-12"
          style={`border-top: 1px solid rgba(12, 12, 12, 0.15);${i === services.length - 1 ? ' border-bottom: 1px solid rgba(12, 12, 12, 0.15);' : ''}`}
        >
          <span class="shrink-0 font-black leading-none text-[#0C0C0C]" style="font-size: clamp(3rem, 10vw, 140px);">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="flex flex-col gap-2 pt-1 text-[#0C0C0C] sm:gap-3 md:pt-3">
            <h3 class="font-medium uppercase leading-tight" style="font-size: clamp(1rem, 2.2vw, 2.1rem);">
              {service.name}
            </h3>
            <p class="max-w-2xl font-light leading-relaxed opacity-60" style="font-size: clamp(0.85rem, 1.6vw, 1.25rem);">
              {service.description}
            </p>
          </div>
        </FadeIn>
      ))
    }
  </ul>
</section>
