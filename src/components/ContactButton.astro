---
interface Props {
  href?: string;
  label?: string;
}

const { href = 'mailto:ivermasco5@gmail.com', label = 'Contáctame' } = Astro.props;
---

<a
  href={href}
  class="inline-block rounded-full px-8 py-3 text-xs font-medium uppercase tracking-widest whitespace-nowrap text-white transition-transform duration-200 hover:scale-[1.03] sm:px-10 sm:py-3.5 sm:text-sm md:px-12 md:py-4 md:text-base"
  style="background: linear-gradient(123deg, #18011F 7%, #B600A8 37%, #7621B0 72%, #BE4C00 100%); box-shadow: 0px 4px 4px rgba(181, 1, 167, 0.25), 4px 4px 12px #7721B1 inset; outline: 2px solid #FFFFFF; outline-offset: -3px;"
>
  {label}
</a>
