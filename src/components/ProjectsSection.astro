---
import FadeIn from './FadeIn.astro';
import LiveProjectButton from './LiveProjectButton.astro';

const base = import.meta.env.BASE_URL;

const projects = [
  {
    name: 'Bocado',
    category: 'PWA de nutrición · IA',
    description:
      'Plan de comidas, contador de calorías y ayuno con los 773 alimentos de la tabla colombiana (TCAC). Funciona offline y reconoce comidas por foto con IA.',
    stack: ['React', 'PWA', 'Django REST', 'PostgreSQL', 'OpenRouter'],
    url: 'https://bocado.iber-mascodev.workers.dev',
    cta: 'Ver en vivo',
    images: ['projects/bocado-detail', 'projects/bocado-phone', 'projects/bocado-hero'],
  },
  {
    name: 'Nexo',
    category: 'SaaS open source · Equipos de TI',
    description:
      'Backlog, planeación y Kanban con flujos configurables por organización. Multi-tenant, sincroniza con Google Sheets y se conecta a Claude vía MCP.',
    stack: ['React 19', 'TanStack Start', 'Django REST', 'PostgreSQL', 'MCP'],
    url: 'https://nexoengine.tech',
    cta: 'Ver en vivo',
    images: ['projects/nexo-detail', 'projects/nexo-phone', 'projects/nexo-laptop'],
  },
  {
    name: 'Salda',
    category: 'Fintech · Asesor de deudas con IA',
    description:
      'Asesor financiero con tool-calling sobre un motor de cálculo propio: audita deudas, simula abonos y revela la tasa real de una cotización desde una foto o PDF.',
    stack: ['React 19', 'Supabase', 'Capacitor', 'Tool-calling'],
    url: 'https://saldas.lat',
    cta: 'Ver en vivo',
    images: ['projects/salda-detail', 'projects/salda-phone', 'projects/salda-laptop'],
  },
  {
    name: 'Turnio',
    category: 'SaaS multi-tenant · Barberías y salones',
    description:
      'Agenda por empleado, asignación automática de turnos y permisos granulares. API con contrato OpenAPI y apps web y móvil con Capacitor.',
    stack: ['Django REST', 'React', 'Capacitor', 'OpenAPI', 'Docker'],
    url: 'https://github.com/IBER-DEV/Turnio',
    cta: 'Ver código',
    images: ['projects/turnio-detail', 'projects/turnio-phone', 'projects/turnio-laptop'],
  },
  {
    name: 'ModaPOS',
    category: 'Retail · POS e inventario',
    description:
      'Punto de venta multi-tenant para moda y calzado: inventario por talla y color, caja, devoluciones y sincronización offline, respaldado por 172 pruebas automatizadas.',
    stack: ['Django 5.2', 'PostgreSQL', 'Redis', 'React'],
    url: 'https://github.com/IBER-DEV/POS-SYSTEM',
    cta: 'Ver código',
    images: ['projects/modapos-detail', 'projects/modapos-counter', 'projects/modapos-tablet'],
  },
];

const total = projects.length;
const imageRadius = 'rounded-[40px] sm:rounded-[50px] md:rounded-[60px]';
---

<section
  id="projects"
  class="relative z-10 -mt-10 rounded-t-[40px] bg-[#0C0C0C] px-5 pt-20 sm:-mt-12 sm:rounded-t-[50px] sm:px-8 sm:pt-24 md:-mt-14 md:rounded-t-[60px] md:px-10 md:pt-32"
>
  <FadeIn
    as="h2"
    delay={0}
    y={40}
    class="hero-heading mb-12 text-center font-black uppercase leading-none tracking-tight sm:mb-16 md:mb-20"
    style="font-size: clamp(3rem, 12vw, 160px);"
  >
    Proyectos
  </FadeIn>

  <div class="mx-auto max-w-6xl" data-card-stack>
    {
      projects.map((project, i) => (
        <div class="sticky top-24 flex h-[85vh] items-start justify-center md:top-32">
          <article
            class="relative w-full origin-top rounded-[40px] border-2 border-[#D7E2EA] bg-[#0C0C0C] p-4 sm:rounded-[50px] sm:p-6 md:rounded-[60px] md:p-8"
            style={`top: ${i * 28}px; will-change: transform;`}
            data-stack-card
            data-target-scale={1 - (total - 1 - i) * 0.03}
          >
            <div class="flex flex-wrap items-start justify-between gap-4 px-2 pb-4 sm:gap-6 sm:px-4 sm:pb-6 md:pb-8">
              <div class="flex w-full min-w-0 items-start gap-4 sm:w-auto sm:flex-1 sm:gap-6 md:gap-8">
                <span class="hero-heading font-black leading-none" style="font-size: clamp(3rem, 10vw, 140px);">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div class="flex min-w-0 flex-col gap-1 sm:gap-2 md:pt-2">
                  <span class="text-xs font-light uppercase tracking-widest text-[#D7E2EA]/60 sm:text-sm md:text-base">
                    {project.category}
                  </span>
                  <h3
                    class="font-medium uppercase leading-tight text-[#D7E2EA]"
                    style="font-size: clamp(1rem, 2.2vw, 2.1rem);"
                  >
                    {project.name}
                  </h3>
                  <p class="max-w-2xl font-light leading-relaxed text-[#D7E2EA]/70" style="font-size: clamp(0.85rem, 1.2vw, 1.05rem);">
                    {project.description}
                  </p>
                  <ul class="mt-1 hidden flex-wrap gap-2 sm:flex">
                    {project.stack.map((tech) => (
                      <li class="rounded-full border border-[#D7E2EA]/25 px-3 py-0.5 text-xs uppercase tracking-wider text-[#D7E2EA]/70">
                        {tech}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <LiveProjectButton href={project.url} label={project.cta} />
            </div>

            <div class="flex gap-3 sm:gap-4">
              <div class="flex w-[40%] flex-col gap-3 sm:gap-4">
                <img
                  src={`${base}images/${project.images[0]}.webp`}
                  alt={`${project.name}: detalle de la interfaz`}
                  loading="lazy"
                  decoding="async"
                  class={`w-full object-cover ${imageRadius}`}
                  style="height: clamp(110px, min(16vw, 22vh), 230px);"
                />
                <img
                  src={`${base}images/${project.images[1]}.webp`}
                  alt={`${project.name}: vista en dispositivo`}
                  loading="lazy"
                  decoding="async"
                  class={`w-full object-cover ${imageRadius}`}
                  style="height: clamp(140px, min(22vw, 30vh), 340px);"
                />
              </div>
              <div class="w-[60%]">
                <img
                  src={`${base}images/${project.images[2]}.webp`}
                  alt={`${project.name}: ${project.category}`}
                  loading="lazy"
                  decoding="async"
                  class={`h-full w-full object-cover ${imageRadius}`}
                />
              </div>
            </div>
          </article>
        </div>
      ))
    }
  </div>
</section>

<script>
  const stack = document.querySelector<HTMLElement>('[data-card-stack]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-stack-card]'));

  if (stack && cards.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;

    // useScroll({ target: stack, offset: ['start start', 'end end'] }) +
    // useTransform(progress, [index / total, 1], [1, targetScale])
    const update = () => {
      ticking = false;
      const rect = stack.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(Math.max(-rect.top / scrollable, 0), 1) : 0;

      cards.forEach((card, i) => {
        const targetScale = Number(card.dataset.targetScale);
        const start = i / cards.length;
        const t = Math.min(Math.max((progress - start) / (1 - start), 0), 1);
        card.style.transform = `scale(${1 + (targetScale - 1) * t})`;
      });
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
