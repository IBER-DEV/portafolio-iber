---
import FadeIn from './FadeIn.astro';
import AnimatedText from './AnimatedText.astro';
import ContactButton from './ContactButton.astro';

const base = import.meta.env.BASE_URL;

const decorations = [
  {
    src: 'images/icon-code.webp',
    width: 440,
    height: 330,
    class: 'top-[4%] left-[1%] w-[120px] sm:left-[2%] sm:w-[160px] md:left-[4%] md:w-[210px]',
    delay: 0.1,
    x: -80,
  },
  {
    src: 'images/icon-database.webp',
    width: 440,
    height: 525,
    class: 'bottom-[8%] left-[3%] w-[100px] sm:left-[6%] sm:w-[140px] md:left-[10%] md:w-[180px]',
    delay: 0.25,
    x: -80,
  },
  {
    src: 'images/icon-terminal.webp',
    width: 440,
    height: 464,
    class: 'top-[4%] right-[1%] w-[120px] sm:right-[2%] sm:w-[160px] md:right-[4%] md:w-[210px]',
    delay: 0.15,
    x: 80,
  },
  {
    src: 'images/icon-cluster.webp',
    width: 440,
    height: 423,
    class: 'bottom-[8%] right-[3%] w-[130px] sm:right-[6%] sm:w-[170px] md:right-[10%] md:w-[220px]',
    delay: 0.3,
    x: 80,
  },
];

const aboutText =
  'Con más de cinco años construyendo software, me enfoco en desarrollo web, sistemas empresariales y experiencia de usuario. Disfruto trabajar con negocios y equipos que quieren optimizar sus procesos y destacar con tecnología bien hecha. ¡Construyamos algo increíble juntos!';
---

<section id="about" class="relative flex min-h-screen flex-col items-center justify-center px-5 py-20 sm:px-8 md:px-10">
  {
    decorations.map((item) => (
      <FadeIn delay={item.delay} x={item.x} y={0} duration={0.9} class={`pointer-events-none absolute ${item.class}`}>
        <img src={`${base}${item.src}`} alt="" width={item.width} height={item.height} loading="lazy" class="block h-auto w-full" />
      </FadeIn>
    ))
  }

  <div class="relative z-10 flex flex-col items-center gap-16 sm:gap-20 md:gap-24">
    <div class="flex flex-col items-center gap-10 sm:gap-14 md:gap-16">
      <FadeIn
        as="h2"
        delay={0}
        y={40}
        class="hero-heading text-center font-black uppercase leading-none tracking-tight"
        style="font-size: clamp(3rem, 12vw, 160px);"
      >
        Sobre mí
      </FadeIn>
      <AnimatedText
        text={aboutText}
        class="max-w-[560px] text-center font-medium leading-relaxed text-[#D7E2EA]"
        style="font-size: clamp(1rem, 2vw, 1.35rem);"
      />
    </div>
    <ContactButton />
  </div>
</section>
