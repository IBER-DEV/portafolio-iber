---
import FadeIn from './FadeIn.astro';

const experience = [
  {
    company: 'ES LATAM',
    roles: [
      { title: 'Analista de Aplicaciones', period: 'Mar 2026 — Actualidad', note: 'Jornada completa' },
      { title: 'Ingeniero de Desarrollo de Software', period: 'Jun 2025 — Dic 2025', note: 'Prácticas' },
    ],
    highlights: [
      'Construí un sistema in-house que automatiza en tiempo real todo lo que ocurre en el patio logístico, desde el ingreso hasta la salida de cada camión.',
      'Diseñé una agenda inteligente que organiza el cargue y descargue de camiones por muelle, capacidad y horario.',
      'Diseño, desarrollo, implementación y adopción de plataformas web, con soluciones cliente/servidor que integran y registran distintas tecnologías y dispositivos.',
      'Participo en distintos proyectos internos tanto en frontend como en backend.',
    ],
    tags: ['Tiempo real', 'Gestión de patio (YMS)', 'Agenda de muelles', 'Cliente/servidor', 'Front & Back'],
  },
];
---

<section id="experience" class="px-5 pb-24 pt-10 sm:px-8 sm:pb-32 md:px-10 md:pb-40">
  <FadeIn
    as="h2"
    delay={0}
    y={40}
    class="hero-heading mb-16 text-center font-black uppercase leading-none tracking-tight sm:mb-20 md:mb-28"
    style="font-size: clamp(3rem, 12vw, 160px);"
  >
    Experiencia
  </FadeIn>

  <ol class="mx-auto max-w-5xl">
    {
      experience.map((item, i) => (
        <FadeIn
          as="li"
          delay={i * 0.1}
          class="grid gap-4 py-8 sm:py-10 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-12 md:py-12"
          style={`border-top: 1px solid rgba(215, 226, 234, 0.15);${i === experience.length - 1 ? ' border-bottom: 1px solid rgba(215, 226, 234, 0.15);' : ''}`}
        >
          <div class="flex flex-col gap-4">
            <h3 class="hero-heading font-black uppercase leading-none" style="font-size: clamp(1.8rem, 4.2vw, 3.4rem);">
              {item.company}
            </h3>
            <ul class="flex flex-col gap-3">
              {item.roles.map((role) => (
                <li class="flex flex-col gap-1">
                  <span class="font-medium uppercase text-[#D7E2EA]" style="font-size: clamp(0.95rem, 1.6vw, 1.25rem);">
                    {role.title}
                  </span>
                  <span class="text-xs font-light uppercase tracking-widest text-[#D7E2EA]/60 sm:text-sm">
                    {role.period}
                    {role.note && ` · ${role.note}`}
                  </span>
                </li>
              ))}
            </ul>
          </div>
          {item.highlights.length > 0 && (
            <div class="flex flex-col gap-5">
              <ul class="flex flex-col gap-3">
                {item.highlights.map((text) => (
                  <li
                    class="relative pl-5 font-light leading-relaxed text-[#D7E2EA]/80 before:absolute before:left-0 before:top-[0.7em] before:h-1.5 before:w-1.5 before:rounded-full before:bg-[#B600A8]"
                    style="font-size: clamp(0.9rem, 1.5vw, 1.15rem);"
                  >
                    {text}
                  </li>
                ))}
              </ul>
              <ul class="flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <li class="rounded-full border border-[#D7E2EA]/25 px-3 py-1 text-xs uppercase tracking-wider text-[#D7E2EA]/70">
                    {tag}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </FadeIn>
      ))
    }
  </ol>
</section>
